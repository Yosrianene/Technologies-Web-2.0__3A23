{% extends 'base.html.twig' %}

{% block title %}Modifier un livre{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4 text-center">✏️ Modifier le livre</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn btn-primary">💾 Enregistrer</button>
        <a href="{{ path('book_list') }}" class="btn btn-secondary">⬅️ Retour</a>
    {{ form_end(form) }}
</div>
{% endblock %}
