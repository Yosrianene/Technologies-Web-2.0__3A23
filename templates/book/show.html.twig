{% extends 'base.html.twig' %}

{% block title %}Détails du livre{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4 text-center">📖 Détails du livre</h1>

    <table class="table table-bordered">
        <tr>
            <th>Titre</th>
            <td>{{ book.title }}</td>
        </tr>
        <tr>
            <th>Auteur</th>
            <td>{{ book.author.username }}</td>
        </tr>
        <tr>
            <th>Date de publication</th>
            <td>{{ book.publicationDate ? book.publicationDate|date('d/m/Y') : '-' }}</td>
        </tr>
        <tr>
            <th>Publié ?</th>
            <td>{{ book.published ? '✅ Oui' : '❌ Non' }}</td>
        </tr>
        <tr>
            <th>Catégorie</th>
            <td>{{ book.category }}</td>
        </tr>
    </table>

    <div class="mt-3">
        <a href="{{ path('book_list') }}" class="btn btn-secondary">⬅️ Retour à la liste</a>
    </div>
</div>
{% endblock %}
