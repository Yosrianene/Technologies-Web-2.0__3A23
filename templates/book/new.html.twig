{% extends 'base.html.twig' %}

{% block title %}Ajouter un livre{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">➕ Ajouter un livre</h1>

    {{ form_start(form) }}
        <div class="mb-3">
            {{ form_label(form.title) }}
            {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Entrez le titre du livre'}}) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.publicationDate) }}
            {{ form_widget(form.publicationDate, {'attr': {'class': 'form-control', 'placeholder': 'jj/mm/aaaa'}}) }}
        </div>

        <div class="mb-3 form-check">
            {{ form_widget(form.published, {'attr': {'class': 'form-check-input'}}) }}
            {{ form_label(form.published, null, {'label_attr': {'class': 'form-check-label'}}) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.author) }}
            {{ form_widget(form.author, {'attr': {'class': 'form-select'}}) }}
        </div>

        <button type="submit" class="btn btn-success">Enregistrer</button>
    {{ form_end(form) }}
</div>
{% endblock %}
